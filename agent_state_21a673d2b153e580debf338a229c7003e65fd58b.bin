import { useState } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Card } from "@/components/ui/card";
import { Radar, Loader2 } from "lucide-react";
import { useMutation } from "@tanstack/react-query";
import { apiRequest } from "@/lib/queryClient";
import { useToast } from "@/hooks/use-toast";
import { useTranslation } from "@/lib/i18n";

interface AuthPageProps {
  onAuth: () => void;
}

export default function AuthPage({ onAuth }: AuthPageProps) {
  const { t } = useTranslation();
  const { toast } = useToast();
  const [isLogin, setIsLogin] = useState(true);
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");

  const authMutation = useMutation({
    mutationFn: async () => {
      const endpoint = isLogin ? "/api/auth/login" : "/api/auth/register";
      const res = await apiRequest("POST", endpoint, { username, password });
      return res.json();
    },
    onSuccess: () => {
      onAuth();
    },
    onError: (err: any) => {
      toast({
        title: isLogin ? "Login Failed" : "Registration Failed",
        description: err.message || "Please try again",
        variant: "destructive",
      });
    },
  });

  return (
    <div className="min-h-screen w-full flex items-center justify-center bg-background p-4">
      <div className="absolute inset-0 opacity-20" style={{
        backgroundImage: "radial-gradient(circle at 50% 30%, hsl(43 74% 49% / 0.15), transparent 60%)"
      }} />

      <div className="relative w-full max-w-sm space-y-6">
        <div className="text-center space-y-2">
          <div className="flex justify-center mb-4">
            <div className="w-16 h-16 rounded-full border-2 border-primary/40 flex items-center justify-center">
              <Radar className="w-8 h-8 text-primary" />
            </div>
          </div>
          <h1 data-testid="text-app-title" className="font-serif text-3xl font-bold text-primary tracking-wide">
            {t("app.name")}
          </h1>
          <p className="text-sm text-muted-foreground tracking-wider">
            {t("app.tagline")}
          </p>
        </div>

        <Card className="p-6 space-y-4 rounded-[20px]">
          <h2 className="text-center text-lg font-semibold text-foreground">
            {isLogin ? t("auth.login") : t("auth.register")}
          </h2>

          <div className="space-y-3">
            <Input
              data-testid="input-username"
              placeholder={t("auth.username")}
              value={username}
              onChange={(e) => setUsername(e.target.value)}
              className="text-sm h-12 rounded-2xl"
            />
            <Input
              data-testid="input-password"
              type="password"
              placeholder={t("auth.password")}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="text-sm h-12 rounded-2xl"
              onKeyDown={(e) => {
                if (e.key === "Enter" && username && password) {
                  authMutation.mutate();
                }
              }}
            />
          </div>

          <Button
            data-testid="button-auth-submit"
            onClick={() => authMutation.mutate()}
            disabled={!username || !password || authMutation.isPending}
            className="w-full tracking-wider uppercase text-sm h-12 rounded-2xl active:scale-[0.98] transition-transform"
          >
            {authMutation.isPending ? (
              <Loader2 className="w-4 h-4 animate-spin" />
            ) : (
              isLogin ? t("auth.login") : t("auth.register")
            )}
          </Button>

          <button
            data-testid="button-toggle-auth"
            onClick={() => setIsLogin(!isLogin)}
            className="w-full text-center text-xs text-primary py-2 active:scale-[0.98] transition-transform"
          >
            {isLogin ? t("auth.noAccount") : t("auth.hasAccount")}
          </button>
        </Card>
      </div>
    </div>
  );
}
